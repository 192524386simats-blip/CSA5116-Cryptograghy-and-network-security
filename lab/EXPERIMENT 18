
#include <stdio.h>
#include <string.h>

int main()
{
    char key[57];
    char C[29], D[29], temp;
    int shift[16] =
    {1,1,2,2,2,2,2,2,1,2,2,2,2,2,2,1};

    printf("Enter 56-bit DES key:\n");
    scanf("%56s", key);

    if(strlen(key) != 56)
    {
        printf("Invalid key! Enter exactly 56 bits.");
        return 0;
    }

    for(int i = 0; i < 56; i++)
    {
        if(key[i] != '0' && key[i] != '1')
        {
            printf("Invalid binary key.");
            return 0;
        }
    }

    strncpy(C, key, 28);
    C[28] = '\0';

    strcpy(D, key + 28);

    printf("\nDES Subkey Generation\n");

    for(int r = 0; r < 16; r++)
    {
        for(int s = 0; s < shift[r]; s++)
        {
            temp = C[0];
            memmove(C, C + 1, 27);
            C[27] = temp;

            temp = D[0];
            memmove(D, D + 1, 27);
            D[27] = temp;
        }

        printf("\nRound %d\n", r + 1);
        printf("C%d = %s\n", r + 1, C);
        printf("D%d = %s\n", r + 1, D);
    }

    return 0;
};

