
#include <stdio.h>
#include <string.h>

void generateSubkey(unsigned char *input,
                    unsigned char *output,
                    int n, unsigned char Rb)
{
    int carry = input[0] >> 7;

    for(int i = 0; i < n; i++)
    {
        int next = (i + 1 < n) ?
                   (input[i + 1] >> 7) : 0;

        output[i] = (input[i] << 1) | next;
    }

    if(carry)
        output[n - 1] ^= Rb;
}

int main()
{
    unsigned char L[16], K1[16], K2[16];
    int bits, n;

    printf("Enter block size (64 or 128): ");
    scanf("%d", &bits);

    if(bits != 64 && bits != 128)
    {
        printf("Invalid block size");
        return 0;
    }

    n = bits / 8;

    printf("Enter %d hexadecimal bytes:\n", n);

    for(int i = 0; i < n; i++)
        scanf("%hhx", &L[i]);

    generateSubkey(L, K1, n,
                   bits == 64 ? 0x1B : 0x87);

    generateSubkey(K1, K2, n,
                   bits == 64 ? 0x1B : 0x87);

    printf("\nCMAC SUBKEY K1:\n");

    for(int i = 0; i < n; i++)
        printf("%02X ", K1[i]);

    printf("\nCMAC SUBKEY K2:\n");

    for(int i = 0; i < n; i++)
        printf("%02X ", K2[i]);

    return 0;
}


