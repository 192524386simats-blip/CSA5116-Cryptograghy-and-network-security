
#include <stdio.h>

int main()
{
    int shift[16] =
    {1,1,2,2,2,2,2,2,1,2,2,2,2,2,2,1};

    int key[16];

    printf("DES Decryption Key Schedule\n");

    for(int i = 0; i < 16; i++)
    {
        key[i] = 16 - i;
    }

    printf("\nDecryption subkey order:\n");

    for(int i = 0; i < 16; i++)
    {
        printf("K%d ", key[i]);
    }

    printf("\n\nShift schedule:\n");

    for(int i = 0; i < 16; i++)
    {
        printf("%d ", shift[i]);
    }

    printf("\n");
    return 0;
}

