
#include <stdio.h>
#include <ctype.h>
#include <string.h>

int main()
{
    char cipher[1000];
    char english[] = "ETAOINSHRDLCUMWFGYPBVKJXQZ";

    int count[26] = {0};
    int used[26] = {0};
    int order[26];
    int i, j, max;

    printf("Enter ciphertext: ");
    fgets(cipher, sizeof(cipher), stdin);

    for(i = 0; cipher[i] != '\0'; i++)
    {
        if(isalpha((unsigned char)cipher[i]))
            count[toupper((unsigned char)cipher[i]) - 'A']++;
    }

    for(i = 0; i < 26; i++)
    {
        max = -1;

        for(j = 0; j < 26; j++)
        {
            if(!used[j] && count[j] > max)
            {
                max = count[j];
                order[i] = j;
            }
        }

        used[order[i]] = 1;
    }

    printf("\nDecrypted possible text:\n");

    for(i = 0; cipher[i] != '\0'; i++)
    {
        if(isalpha((unsigned char)cipher[i]))
        {
            int pos = toupper((unsigned char)cipher[i]) - 'A';
            char ch = 'E';

            for(j = 0; j < 26; j++)
            {
                if(order[j] == pos)
                {
                    ch = english[j];
                    break;
                }
            }

            if(islower((unsigned char)cipher[i]))
                ch = tolower(ch);

            printf("%c", ch);
        }
        else
            printf("%c", cipher[i]);
    }

    return 0;
}


