
#include <stdio.h>
#include <string.h>

int main()
{
    char data[200];
    int block, len, i, padding;

    printf("Enter binary plaintext: ");
    scanf("%199s", data);

    printf("Enter block size: ");
    scanf("%d", &block);

    len = strlen(data);

    if(block <= 0)
    {
        printf("Invalid block size");
        return 0;
    }

    for(i = 0; i < len; i++)
    {
        if(data[i] != '0' && data[i] != '1')
        {
            printf("Enter binary data only");
            return 0;
        }
    }

    padding = block - (len % block);

    printf("\nOriginal plaintext: %s", data);
    printf("\nPadding bits: 1");

    for(i = 1; i < padding; i++)
        printf("0");

    printf("\nPadded plaintext: %s1", data);

    for(i = 1; i < padding; i++)
        printf("0");

    printf("\nTotal bits: %d\n", len + padding);

    return 0;
}

