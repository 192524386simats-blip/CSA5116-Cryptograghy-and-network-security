
#include <stdio.h>

int mod(int x)
{
    return (x % 26 + 26) % 26;
}

int inverse(int x)
{
    for(int i = 1; i < 26; i++)
        if((x * i) % 26 == 1)
            return i;

    return -1;
}

int main()
{
    int p[2][2], c[2][2], inv[2][2];
    int det, d, key[2][2];

    printf("Enter two plaintext pairs (A=0 to Z=25):\n");

    for(int i = 0; i < 2; i++)
        for(int j = 0; j < 2; j++)
            scanf("%d", &p[i][j]);

    printf("Enter corresponding ciphertext pairs:\n");

    for(int i = 0; i < 2; i++)
        for(int j = 0; j < 2; j++)
            scanf("%d", &c[i][j]);

    det = mod(p[0][0] * p[1][1] -
              p[0][1] * p[1][0]);

    d = inverse(det);

    if(d == -1)
    {
        printf("Plaintext matrix has no inverse modulo 26.");
        return 0;
    }

    inv[0][0] = mod(p[1][1] * d);
    inv[0][1] = mod(-p[0][1] * d);
    inv[1][0] = mod(-p[1][0] * d);
    inv[1][1] = mod(p[0][0] * d);

    for(int i = 0; i < 2; i++)
    {
        for(int j = 0; j < 2; j++)
        {
            key[i][j] = 0;

            for(int k = 0; k < 2; k++)
                key[i][j] += c[i][k] * inv[k][j];

            key[i][j] = mod(key[i][j]);
        }
    }

    printf("\nRecovered Hill Cipher Key:\n");

    for(int i = 0; i < 2; i++)
    {
        for(int j = 0; j < 2; j++)
            printf("%d ", key[i][j]);

        printf("\n");
    }

    return 0;
}


