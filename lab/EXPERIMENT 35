
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char plaintext[100];
    int key[100], i, j = 0;
    int length;

    printf("Enter plaintext: ");
    fgets(plaintext, sizeof(plaintext), stdin);

    length = strlen(plaintext);

    printf("Enter numerical key stream:\n");

    for(i = 0; i < length; i++)
    {
        if(isalpha((unsigned char)plaintext[i]))
        {
            scanf("%d", &key[j]);

            if(key[j] < 0 || key[j] > 25)
            {
                printf("Invalid key value");
                return 0;
            }

            j++;
        }
    }

    printf("\nEncrypted ciphertext: ");

    j = 0;

    for(i = 0; i < length; i++)
    {
        if(isalpha((unsigned char)plaintext[i]))
        {
            int p = toupper((unsigned char)plaintext[i]) - 'A';
            int c = (p + key[j]) % 26;

            printf("%c", c + 'A');
            j++;
        }
        else
        {
            printf("%c", plaintext[i]);
        }
    }

    printf("\n");

    return 0;
}


