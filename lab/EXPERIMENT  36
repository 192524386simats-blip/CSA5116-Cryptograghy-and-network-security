
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int gcd(int a, int b)
{
    while(b)
    {
        int t = b;
        b = a % b;
        a = t;
    }
    return a;
}

int main()
{
    char text[100];
    int a, b, i;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter key a: ");
    scanf("%d", &a);

    printf("Enter key b: ");
    scanf("%d", &b);

    a = (a % 26 + 26) % 26;
    b = (b % 26 + 26) % 26;

    if(gcd(a, 26) != 1)
    {
        printf("Invalid key a");
        return 0;
    }

    printf("\nEncrypted text: ");

    for(i = 0; text[i] != '\0'; i++)
    {
        if(isalpha((unsigned char)text[i]))
        {
            int p = toupper((unsigned char)text[i]) - 'A';
            int c = (a * p + b) % 26;
            printf("%c", c + 'A');
        }
        else
            printf("%c", text[i]);
    }

    return 0;
}


