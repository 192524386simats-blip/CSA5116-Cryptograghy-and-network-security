
#include <stdio.h>

int gcd(int a, int b)
{
    while(b != 0)
    {
        int t = b;
        b = a % b;
        a = t;
    }
    return a;
}

int main()
{
    int n, m, g;

    printf("Enter RSA modulus n: ");
    scanf("%d", &n);

    printf("Enter known plaintext block: ");
    scanf("%d", &m);

    if(n <= 1 || m <= 0)
    {
        printf("Invalid input");
        return 0;
    }

    g = gcd(n, m);

    printf("\nRSA COMMON FACTOR ATTACK\n");
    printf("Modulus n = %d\n", n);
    printf("Plaintext block = %d\n", m);
    printf("GCD = %d\n", g);

    if(g > 1 && g < n)
    {
        printf("Factor 1 = %d\n", g);
        printf("Factor 2 = %d\n", n / g);
        printf("RSA modulus factor revealed!");
    }
    else
    {
        printf("No non-trivial factor revealed.");
    }

    return 0;
}


