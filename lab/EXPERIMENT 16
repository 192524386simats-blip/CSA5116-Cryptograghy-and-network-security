
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char cipher[1000], plain[1000];
    char freq[] = "ETAOINSHRDLCUMWFGYPBVKJXQZ";
    int count[26] = {0};
    int i, j, max;

    printf("Enter ciphertext:\n");
    fgets(cipher, sizeof(cipher), stdin);

    for(i = 0; cipher[i] != '\0'; i++)
    {
        if(isalpha((unsigned char)cipher[i]))
            count[toupper((unsigned char)cipher[i]) - 'A']++;
    }

    char order[26];
    int used[26] = {0};

    for(i = 0; i < 26; i++)
    {
        max = -1;
        for(j = 0; j < 26; j++)
        {
            if(!used[j] && count[j] > max)
            {
                max = count[j];
                order[i] = j;
            }
        }
        used[(int)order[i]] = 1;
    }

    printf("\nPossible plaintext:\n");

    for(i = 0; cipher[i] != '\0'; i++)
    {
        if(isalpha((unsigned char)cipher[i]))
        {
            int index = 0;
            while(index < 26 && order[index] !=
                  toupper((unsigned char)cipher[i]) - 'A')
                index++;

            char ch = freq[index];

            if(islower((unsigned char)cipher[i]))
                ch = tolower(ch);

            putchar(ch);
        }
        else
            putchar(cipher[i]);
    }

    return 0;
}

